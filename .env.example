SESSION_SECRET="super-duper-s3cret"
HONEYPOT_SECRET="super-duper-s3cret"
INTERNAL_COMMAND_TOKEN="some-made-up-token"
SENTRY_DSN="your-dsn"
# SENTRY_ORG and SENTRY_PROJECT are BUILD-TIME only — @sentry/vite-plugin reads
# them while the image is being built (vite.config.ts) and never again, so the
# deploy workflow passes them to `flyctl deploy --build-secret` and
# other/Dockerfile mounts them into the build stage. Setting them here has no
# effect on a deployed app.
#
# Left empty rather than filled with a placeholder on purpose: a local build
# skips release management unless SENTRY_AUTH_TOKEN is also set, and once it is,
# getSentryPlugin() treats an empty value as missing and refuses to build.
# A placeholder like "your-org-slug" would pass that check and send an
# authenticated request to an org that does not exist, which the plugin logs and
# then swallows — a green build and no release, which is the bug this guards.
SENTRY_ORG=""
SENTRY_PROJECT=""

NODEMAILER_HOST="your-host"
NODEMAILER_USER="your-email"
NODEMAILER_PASSWORD="your-password"

HASHNODE_PUBLICATION_ID="your-publication-id"
HASHNODE_PUBLICATION_HOST="your-publication-host"

POSTHOG_API_KEY="your-posthog-api-key"
UMAMI_WEBSITE_ID="your-umami-website-id"
UMAMI_DOMAINS="your-umami-domains" # comma separated list of domains the umami script should track - https://umami.is/docs/tracker-configuration#data-domains
UMAMI_DOMAIN="your-umami-domain" # umami domain - https://umami.is/docs/bypass-ad-blockers#using-environment-variables-self-hosting
UMAMI_SCRIPT_NAME="your-umami-script-name" # umami script name - https://umami.is/docs/bypass-ad-blockers#using-environment-variables-self-hosting
UMAMI_PUBLIC_ANALYTICS_URL="your-umami-public-analytics-url" # https://umami.is/docs/enable-share-url

# Set to "false" on non-production deploys (staging, previews) so they are not
# indexed and do not compete with production in search results. It emits
# `X-Robots-Tag: noindex, nofollow` plus a <meta name="robots"> tag. Leave it
# unset (or "true") in production.
ALLOW_INDEXING="false"
